    "ci-auto-merge.yml": {
      "credential_names": [],
      "events": {
        "workflow_run": {
          "types": [
            "completed"
          ],
          "workflows": [
            "CI"
          ]
        }
      },
      "jobs": {
        "dependabot-auto-merge": {
          "if": "github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'pull_request'",
          "name": "Dependabot Auto Merge",
          "permissions": {
            "actions": "read",
            "checks": "write",
            "contents": "write",
            "pull-requests": "write",
            "vulnerability-alerts": "read"
          }
        }
      },
      "name": "Dependabot Auto Merge",
      "permissions": {
        "contents": "read"
      },
      "source_sha256": "dd1f5f4b70fc667ea4db048342a2967ba2f4529d63d8a50e431df35ab069b969",
      "variable_names": [
        "LINT_EASTWOOD_REVIEWER_LOGIN",
        "OBI_WAN_REVIEWER_LOGIN",
        "ROBOCOP_REVIEWER_LOGIN"
      ]
    },
    "ci-orchestrator.yml": {
      "credential_names": [
        "LINT_EASTWOOD_OPENAI_API_KEY",
        "LINT_EASTWOOD_PRIVATE_KEY",
        "OBI_WAN_CODE_NOBI_PRIVATE_KEY",
        "OBI_WAN_OPENAI_API_KEY",
        "ROBOCOP_OPENAI_API_KEY",
        "ROBOCOP_PRIVATE_KEY"
      ],
      "events": {
        "pull_request": {
          "branches": [
            "main"
          ],
          "types": [
            "opened",
            "synchronize",
            "reopened",
            "ready_for_review"
          ]
        }
      },
      "jobs": {
        "build-review": {
          "if": "always() && github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Build Sheriff Review",
          "needs": [
            "lints",
            "tests"
          ],
          "permissions": {
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-build.yml"
        },
        "code-review": {
          "if": "github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Code Review",
          "permissions": {
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-code.yml"
        },
        "codeql": {
          "name": "CodeQL",
          "permissions": {
            "actions": "read",
            "contents": "read",
            "pull-requests": "read",
            "security-events": "write"
          },
          "uses": "./.github/workflows/gate-codeql.yml"
        },
        "dependency-malware": {
          "name": "Dependency scope",
          "uses": "./.github/workflows/gate-malware.yml"
        },
        "dependency-vulnerability": {
          "name": "Vulnerability",
          "permissions": {
            "contents": "read",
            "pull-requests": "read"
          },
          "uses": "./.github/workflows/gate-vulnerability.yml"
        },
        "lints": {
          "name": "Lints",
          "uses": "./.github/workflows/gate-lint.yml"
        },
        "result": {
          "if": "always()",
          "name": "Required CI",
          "needs": [
            "lints",
            "tests",
            "codeql",
            "dependency-vulnerability",
            "dependency-malware",
            "secrets",
            "code-review",
            "build-review",
            "security-review"
          ]
        },
        "secrets": {
          "name": "Secret scan",
          "uses": "./.github/workflows/gate-secrets.yml"
        },
        "security-review": {
          "if": "always() && github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Security Review",
          "needs": [
            "codeql",
            "dependency-vulnerability",
            "dependency-malware",
            "secrets"
          ],
          "permissions": {
            "actions": "read",
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "security-events": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-security.yml"
        },
        "tests": {
          "name": "Tests",
          "uses": "./.github/workflows/validate.yml"
        }
      },
      "name": "CI",
      "permissions": {
        "contents": "read"
      },
      "source_sha256": "de1242702ea6c3992cf6c0417c6ad565a809a4aa06769705b3a83c062e104733",
      "variable_names": []
    },
    "deploy-gateway.yml": {
      "credential_names": [
        "DEPLOY_SSH_KEY"
      ],
      "events": {
        "push": {
          "branches": [
            "env-prod"
          ]
        },
        "workflow_dispatch": {
          "inputs": {
            "operation": {
              "default": "deploy",
              "description": "Gateway operation (select env-prod above; rollback requires explicit authorization).",
              "options": [
                "deploy",
                "rollback"
              ],
              "type": "choice"
            },
            "recovery": {
              "default": "",
              "description": "For rollback, exact retained failed/current release ID from the host journal.",
              "type": "string"
            }
          }
        }
      },
      "jobs": {
        "deploy": {
          "if": "github.repository == 'VanillaIceCube/JudeAndrewAlabaInfrastructure' && github.ref == 'refs/heads/env-prod' && vars.DEPLOY_ENABLED == 'true' && github.actor == github.repository_owner && github.triggering_actor == github.repository_owner",
          "permissions": {
            "contents": "read"
          }
        }
      },
      "name": "Deploy gateway",
      "permissions": {
        "contents": "read"
      },
      "source_sha256": "7fb9d84803d39b2af7ee7f4480f7851a6915c3bf1823d3664aadd60a6d8ae239",
      "variable_names": [
        "DEPLOY_ENABLED",
        "DEPLOY_HOST",
        "DEPLOY_HOST_FINGERPRINT",
        "DEPLOY_PORT",
        "DEPLOY_USER"
      ]
    },
    "gate-codeql.yml": {
      "credential_names": [],
      "events": {
        "push": {
          "branches": [
            "main"
          ]
        },
        "schedule": [
          {
            "cron": "24 10 * * 1"
          }
        ],
        "workflow_call": {
          "outputs": {
            "scope_actions": {
              "description": "Whether the pull request requires GitHub Actions analysis.",
              "value": "${{ jobs.changes.outputs.actions }}"
            },
            "scope_javascript": {
              "description": "Whether the pull request requires JavaScript/TypeScript analysis.",
              "value": "${{ jobs.changes.outputs.javascript }}"
            },
            "scope_python": {
              "description": "Whether the pull request requires Python analysis.",
              "value": "${{ jobs.changes.outputs.python }}"
            },
            "scope_status": {
              "description": "Whether path-aware CodeQL scope detection succeeded.",
              "value": "${{ jobs.changes.outputs.scope_status }}"
            }
          }
        },
        "workflow_dispatch": ""
      },
      "jobs": {
        "analyze-actions": {
          "if": "needs.changes.outputs.actions == 'true'",
          "name": "Analyze GitHub Actions",
          "needs": "changes"
        },
        "analyze-javascript": {
          "if": "needs.changes.outputs.javascript == 'true'",
          "name": "Analyze JavaScript/TypeScript",
          "needs": "changes"
        },
        "analyze-python": {
          "if": "needs.changes.outputs.python == 'true'",
          "name": "Analyze Python",
          "needs": "changes"
        },
        "changes": {
          "name": "Detect CodeQL Scope",
          "permissions": {
            "contents": "read",
            "pull-requests": "read"
          }
        }
      },
      "name": "CodeQL Gate",
      "permissions": {
        "actions": "read",
        "contents": "read",
        "pull-requests": "read",
        "security-events": "write"
      },
      "source_sha256": "cf7fd2fa5d6974e256c3b433d39ce2b7e12f82c4684a79936600c782dabfa6eb",
      "variable_names": []
    },
