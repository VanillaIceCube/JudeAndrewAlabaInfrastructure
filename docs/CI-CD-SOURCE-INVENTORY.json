    "ci-orchestrator.yml": {
      "credential_names": [
        "LINT_EASTWOOD_OPENAI_API_KEY",
        "LINT_EASTWOOD_PRIVATE_KEY",
        "OBI_WAN_CODE_NOBI_PRIVATE_KEY",
        "OBI_WAN_OPENAI_API_KEY",
        "ROBOCOP_OPENAI_API_KEY",
        "ROBOCOP_PRIVATE_KEY"
      ],
      "events": {
        "pull_request": {
          "branches": [
            "main"
          ],
          "types": [
            "opened",
            "synchronize",
            "reopened",
            "ready_for_review"
          ]
        }
      },
      "jobs": {
        "build-review": {
          "if": "always() && github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Build Sheriff Review",
          "needs": [
            "lints",
            "tests"
          ],
          "permissions": {
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-build.yml"
        },
        "code-review": {
          "if": "github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Code Review",
          "permissions": {
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-code.yml"
        },
        "codeql": {
          "name": "CodeQL",
          "permissions": {
            "actions": "read",
            "contents": "read",
            "security-events": "write"
          },
          "uses": "./.github/workflows/gate-codeql.yml"
        },
        "dependency-malware": {
          "name": "Dependency scope",
          "uses": "./.github/workflows/gate-malware.yml"
        },
        "dependency-vulnerability": {
          "name": "Vulnerability",
          "permissions": {
            "contents": "read",
            "pull-requests": "read"
          },
          "uses": "./.github/workflows/gate-vulnerability.yml"
        },
        "lints": {
          "name": "Lints",
          "uses": "./.github/workflows/gate-lint.yml"
        },
        "result": {
          "if": "always()",
          "name": "Required CI",
          "needs": [
            "lints",
            "tests",
            "codeql",
            "dependency-vulnerability",
            "dependency-malware",
            "secrets",
            "code-review",
            "build-review",
            "security-review"
          ]
        },
        "secrets": {
          "name": "Secret scan",
          "uses": "./.github/workflows/gate-secrets.yml"
        },
        "security-review": {
          "if": "always() && github.event.pull_request.head.repo.full_name == github.repository",
          "name": "AI Security Review",
          "needs": [
            "codeql",
            "dependency-vulnerability",
            "dependency-malware",
            "secrets"
          ],
          "permissions": {
            "actions": "read",
            "checks": "read",
            "contents": "read",
            "pull-requests": "read",
            "security-events": "read",
            "statuses": "read"
          },
          "uses": "./.github/workflows/review-security.yml"
        },
        "tests": {
          "name": "Tests",
          "uses": "./.github/workflows/validate.yml"
        }
      },
      "name": "CI",
      "permissions": {
        "contents": "read"
      },
      "source_sha256": "0ff7fb35e61ece420da936fe73c7d1303f64c60c909c27854a103f7dbd3977e8",
      "variable_names": []
    },
    "deploy-gateway.yml": {
      "credential_names": [
        "DEPLOY_SSH_KEY"
      ],
      "events": {
        "push": {
          "branches": [
            "env-prod"
          ]
        },
        "workflow_dispatch": {
          "inputs": {
            "operation": {
              "default": "deploy",
              "description": "Gateway operation (select env-prod above; rollback requires explicit authorization).",
              "options": [
                "deploy",
                "rollback"
              ],
              "type": "choice"
            },
            "recovery": {
              "default": "",
              "description": "For rollback, exact retained failed/current release ID from the host journal.",
              "type": "string"
            }
          }
        }
      },
      "jobs": {
        "deploy": {
          "if": "github.repository == 'VanillaIceCube/JudeAndrewAlabaInfrastructure' && github.ref == 'refs/heads/env-prod' && vars.DEPLOY_ENABLED == 'true' && github.actor == github.repository_owner && github.triggering_actor == github.repository_owner",
          "permissions": {
            "contents": "read"
          }
        }
      },
      "name": "Deploy gateway",
      "permissions": {
        "contents": "read"
      },
      "source_sha256": "1482c6f662b69bfdb3a0d578d08bed4045cf7a202a08473702d1d2aaf573f323",
      "variable_names": [
        "DEPLOY_ENABLED",
        "DEPLOY_HOST",
        "DEPLOY_HOST_FINGERPRINT",
        "DEPLOY_PORT",
        "DEPLOY_USER"
      ]
    },
    "gate-codeql.yml": {
      "credential_names": [],
      "events": {
        "push": {
          "branches": [
            "main"
          ]
        },
        "schedule": [
          {
            "cron": "24 10 * * 1"
          }
        ],
        "workflow_call": {
          "outputs": {
            "scope_actions": {
              "description": "Workflow and composite Actions scope.",
              "value": "${{ jobs.scope.outputs.actions }}"
            },
            "scope_javascript": {
              "description": "Automation JavaScript scope.",
              "value": "${{ jobs.scope.outputs.javascript }}"
            },
            "scope_python": {
              "description": "Python scope.",
              "value": "${{ jobs.scope.outputs.python }}"
            },
            "scope_status": {
              "description": "All three present languages are always analyzed.",
              "value": "${{ jobs.scope.outputs.status }}"
            }
          }
        },
        "workflow_dispatch": ""
      },
      "jobs": {
        "analyze": {
          "name": "${{ matrix.name }}",
          "needs": "scope"
        },
        "scope": {
          "name": "Detect CodeQL Scope"
        }
      },
      "name": "CodeQL Gate",
      "permissions": {
        "actions": "read",
        "contents": "read",
        "security-events": "write"
      },
      "source_sha256": "9d3185ae5242069c2b632e047516a35437181d2c44c3d12e58c6e6d47b8d4a03",
      "variable_names": []
    },
