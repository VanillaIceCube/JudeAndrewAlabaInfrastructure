{
  "custom_action_consumers": {
    "./.github/actions/collect-prior-ai-reviews": [
      ".github/workflows/review-build.yml",
      ".github/workflows/review-code.yml",
      ".github/workflows/review-security.yml"
    ],
    "./.github/actions/get-pr-diff": [
      ".github/workflows/review-build.yml",
      ".github/workflows/review-code.yml",
      ".github/workflows/review-security.yml"
    ],
    "./.github/actions/openai-chat": [
      ".github/workflows/review-build.yml",
      ".github/workflows/review-code.yml",
      ".github/workflows/review-security.yml",
      ".github/actions/security-alerts/action.yml"
    ],
    "./.github/actions/publish-ai-review": [
      ".github/workflows/review-build.yml",
      ".github/workflows/review-build.yml",
      ".github/workflows/review-code.yml",
      ".github/workflows/review-code.yml",
      ".github/workflows/review-security.yml",
      ".github/workflows/review-security.yml"
    ],
    "./.github/actions/security-alerts": [
      ".github/workflows/alert-codeql.yml",
      ".github/workflows/alert-malware.yml",
      ".github/workflows/alert-vulnerability.yml"
    ]
  },
